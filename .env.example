# Postgres connection string (Neon/Supabase free tier or local Postgres).
# Real Postgres is required — see ISA.md Decisions for why this project does
# not use SQLite even for local dev.
DATABASE_URL=postgres://user:password@host:5432/uptime_monitor

# Better-Auth secret — generate with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Shared secret the Vercel Cron job must present to /api/cron/run-checks (ISC-46).
CRON_SECRET=

# Transactional email provider for alert delivery (ISC-53/54/58) — Resend recommended,
# see ISA.md Decisions "Alert email provider decision".
RESEND_API_KEY=
